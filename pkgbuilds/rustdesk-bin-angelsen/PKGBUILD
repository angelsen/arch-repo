# Maintainer: Fredrik Angelsen <fredrikangelsen@gmail.com>

pkgname=rustdesk-bin-angelsen
_pkgname=rustdesk
pkgver=1.4.4
pkgrel=2
pkgdesc="Remote desktop software, the open source TeamViewer alternative"
arch=('x86_64')
url="https://rustdesk.com"
license=('AGPL-3.0')
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator' 'pam' 'gst-plugins-base' 'gst-plugin-pipewire')
provides=('rustdesk')
conflicts=('rustdesk' 'rustdesk-bin')
install=${pkgname}.install
source=("https://github.com/rustdesk/rustdesk/releases/download/${pkgver}/${_pkgname}-${pkgver}-0-${CARCH}.pkg.tar.zst")
sha256sums=('548397cb46c6d173de5ee6463963be6df01c72c13a62465c22631a07d49aac7d')

package() {
    # Extract the upstream package, excluding metadata files
    tar -xf "${srcdir}/${_pkgname}-${pkgver}-0-${CARCH}.pkg.tar.zst" -C "${pkgdir}" --exclude='.BUILDINFO' --exclude='.INSTALL' --exclude='.MTREE' --exclude='.PKGINFO'

    # The upstream package already contains everything in the correct locations
    # /usr/bin/rustdesk
    # /usr/share/icons/
    # /usr/share/rustdesk/
}
