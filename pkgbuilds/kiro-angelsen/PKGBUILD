# Maintainer: Fredrik Angelsen <fredrikangelsen@gmail.com>

pkgname=kiro-angelsen
epoch=1
pkgver=1.4.62
pkgrel=1
pkgdesc="AI IDE for prototype to production by AWS"
arch=('x86_64')
url="https://kiro.aws"
license=('LicenseRef-Kiro')
depends=('alsa-lib' 'gtk3' 'libcups' 'libsecret' 'libxkbfile' 'libxss' 'libxtst' 'nss' 'xdg-utils')
optdepends=('libgnome-keyring: password storage'
    'webkit2gtk-4.1: Microsoft account sign-in extension')
provides=('kiro')
conflicts=('kiro')
options=('!strip' '!emptydirs')
install="${pkgname}.install"
source=("kiro-ide-${pkgver}-stable-linux-x64.deb::https://prod.download.desktop.kiro.dev/releases/stable/linux-x64/signed/${pkgver}/deb/kiro-ide-${pkgver}-stable-linux-x64.deb")
sha512sums=('058f7281de80a94ea12083970713f21f5e1e465974ed886083c50f8e4905aeef4f8400fde15412018135e2b49b64db42fea2a9660eed79d6746ab9a0254d3f27')

package() {
    # Extract the data from the deb package
    bsdtar -xf data.tar.xz -C "$pkgdir/"

    # Move from /usr/share/kiro to /opt/kiro
    install -dm755 "$pkgdir/opt"
    mv "$pkgdir/usr/share/kiro" "$pkgdir/opt/kiro"

    # Create symlink for the binary
    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/kiro/kiro "$pkgdir/usr/bin/kiro"

    # Desktop files and bash completion are already in correct locations
    # (/usr/share/applications/, /usr/share/bash-completion/)

    # The deb ships chrome-sandbox setuid; kiro-angelsen.install restores it only when needed
    chmod 755 "$pkgdir/opt/kiro/chrome-sandbox"

    install -Dm644 "$pkgdir/opt/kiro/resources/app/LICENSE.txt" \
        "$pkgdir/usr/share/licenses/${pkgname}/LICENSE.txt"
    install -Dm644 "$pkgdir/opt/kiro/LICENSES.chromium.html" \
        "$pkgdir/usr/share/licenses/${pkgname}/LICENSES.chromium.html"

    # Clean up appdata (not standard on Arch)
    rm -rf "$pkgdir/usr/share/appdata"
}
