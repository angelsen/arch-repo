# shellcheck shell=bash
post_install() {
    # Setuid chrome-sandbox only when unprivileged user namespaces are unavailable.
    if ! { [[ -L /proc/self/ns/user ]] && unshare --user true 2>/dev/null; }; then
        chmod 4755 '/opt/kiro/chrome-sandbox' || true
    fi

    cat <<EOF

==> Kiro IDE has been installed to /opt/kiro

==> To use Kiro, you'll need to sign in with your AWS account.
    If you're on the waitlist, enter your invitation code when prompted.

==> Run 'kiro' to get started.

==> For more information, visit: https://kiro.aws

EOF
}

post_upgrade() {
    post_install
}
