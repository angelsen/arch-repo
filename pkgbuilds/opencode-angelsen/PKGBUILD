pkgname=opencode-angelsen
pkgver=1.19.5
pkgrel=1
provides=('opencode')
conflicts=('opencode')
pkgdesc="An open source AI coding agent"
arch=('x86_64')
url="https://opencode.ai"
license=('MIT')
options=('!strip')
depends=()
optdepends=(
    'git: For git operations'
    'github-cli: For GitHub workflows'
)
source=("opencode-${pkgver}.tar.gz::https://github.com/anomalyco/opencode/releases/download/v${pkgver}/opencode-linux-x64.tar.gz"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/anomalyco/opencode/v${pkgver}/LICENSE")
sha256sums=('588310a336fa3b9df36b3f0225b26f679d453efaad0cf3d66c3651ef3ec1647a'
            '625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b')

package() {
    install -Dm755 "${srcdir}/opencode" "${pkgdir}/usr/bin/opencode"
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
