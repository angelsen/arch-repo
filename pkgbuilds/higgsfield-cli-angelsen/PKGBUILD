pkgname=higgsfield-cli-angelsen
_pkgname=hf
pkgver=1.1.26
pkgrel=1
pkgdesc="Generate images, videos, 3D assets, and audio from the terminal using 40+ Higgsfield AI models"
arch=('x86_64')
url="https://github.com/higgsfield-ai/cli"
license=('MIT')
provides=('higgsfield-cli' 'higgsfield')
conflicts=('higgsfield-cli' 'higgsfield')
source=("${_pkgname}_${pkgver}_linux_amd64.tar.gz::https://github.com/higgsfield-ai/cli/releases/download/v${pkgver}/${_pkgname}_${pkgver}_linux_amd64.tar.gz"
    "LICENSE::https://raw.githubusercontent.com/higgsfield-ai/cli/v${pkgver}/LICENSE")
sha256sums=('5d666fae70c99b7388690191a649d1487962250ed50820e079edfd1ffac7bf5b'
            '9da656d6226936542be59478dbf775057dfdeade2629d35e0832108c2b7aecc0')

package() {
    install -Dm755 "${srcdir}/${_pkgname}" "${pkgdir}/usr/bin/higgsfield"
    ln -s higgsfield "${pkgdir}/usr/bin/higgs"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
