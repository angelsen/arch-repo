# Maintainer: Fredrik Angelsen <fredrikangelsen@gmail.com>

pkgname=claude-code-angelsen
pkgver=2.1.138
pkgrel=1
provides=('claude-code')
conflicts=('claude-code')
pkgdesc="An agentic coding tool by Anthropic that lives in your terminal"
arch=('x86_64')
url="https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview"
license=('custom:Anthropic')
options=('!strip')
optdepends=(
    'git: For git operations'
    'github-cli: For PR workflows with GitHub'
    'glab: For PR workflows with GitLab'
    'bubblewrap: For /sandbox feature'
    'tmux: For tmux pane integration'
)
install="${pkgname}.install"
source=("claude-${pkgver}::https://downloads.claude.ai/claude-code-releases/${pkgver}/linux-x64/claude")
noextract=("claude-${pkgver}")
sha256sums=('c3c56ffbc12cf16e40c33687c9fe6361ed250c35a9e1718d0c38d49049f5f8c3')

package() {
    install -Dm755 "${srcdir}/claude-${pkgver}" "${pkgdir}/usr/bin/claude"
}
