#!/usr/bin/env python3
"""
ap-dev - Development tool for managing Angelsen's Arch Repository
"""

import sys
import json
import argparse
import subprocess
import shutil
import re
import hashlib
from pathlib import Path
from typing import Dict, List, Optional, Tuple

VERSION = "1.0.0"


# Colors for output
class Colors:
    RED = "\033[0;31m"
    GREEN = "\033[0;32m"
    BLUE = "\033[0;34m"
    YELLOW = "\033[1;33m"
    NC = "\033[0m"  # No Color


def info(msg: str):
    print(f"{Colors.BLUE}→{Colors.NC} {msg}")


def success(msg: str):
    print(f"{Colors.GREEN}✓{Colors.NC} {msg}")


def error(msg: str):
    print(f"{Colors.RED}✗{Colors.NC} {msg}", file=sys.stderr)


def warning(msg: str):
    print(f"{Colors.YELLOW}⚠{Colors.NC} {msg}")


class ApDev:
    def __init__(self):
        self.repo_root = Path(__file__).parent
        self.pkgbuilds_dir = self.repo_root / "pkgbuilds"
        self.packages_json = self.repo_root / "packages.json"
        self.git_cmd = "/usr/bin/git"  # Use system git to avoid wrapper issues

    def run_git(self, args: List[str], cwd: Optional[Path] = None, **kwargs):
        """Run git command with full path to avoid wrapper issues"""
        cmd = [self.git_cmd] + args
        if cwd is None:
            cwd = self.repo_root
        return subprocess.run(cmd, cwd=cwd, **kwargs)

    # makepkg's integrity arrays, mapped to the hashlib constructor for each.
    # b2sums are BLAKE2b-512, which is hashlib.blake2b's default digest size.
    SUM_ALGOS = {
        "md5": "md5",
        "sha1": "sha1",
        "sha224": "sha224",
        "sha256": "sha256",
        "sha384": "sha384",
        "sha512": "sha512",
        "b2": "blake2b",
    }

    @staticmethod
    def local_source_files(sources: List[str]) -> List[Tuple[int, str]]:
        """Source entries shipped in the package dir, as (index, filename).

        The index is kept so callers can line an entry up with its checksum in
        the parallel sums array.
        """
        local = []
        for index, entry in enumerate(sources):
            # `filename::uri` renames a download, so the uri decides whether the
            # entry is remote; a bare entry with no protocol is a local file.
            uri = entry.split("::", 1)[-1]
            if re.match(r"^[a-z][a-z0-9+.-]*://", uri):
                continue
            local.append((index, uri))
        return local

    @staticmethod
    def file_digest(path: Path, algo: str) -> str:
        digest = hashlib.new(algo)
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        return digest.hexdigest()

    def parse_pkgbuild(self, pkgbuild_path: Path) -> Optional[Dict]:
        """Extract package info from PKGBUILD"""
        if not pkgbuild_path.exists():
            return None

        try:
            # Source the PKGBUILD and extract variables. The scalar metadata
            # goes on one pipe-delimited line; source=() follows in its own
            # newline-delimited section so array entries survive intact.
            cmd = f'''
                source "{pkgbuild_path}" 2>/dev/null
                echo "${{pkgname}}|${{pkgver}}|${{pkgrel}}|${{pkgdesc}}|${{url}}"
                echo "---SOURCE---"
                printf '%s\\n' "${{source[@]}}"
                echo "---INSTALL---"
                echo "${{install}}"
                echo "---SUMS---"
                for algo in {" ".join(self.SUM_ALGOS)}; do
                    ref="${{algo}}sums[@]"
                    vals=("${{!ref}}")
                    if [ "${{#vals[@]}}" -gt 0 ]; then
                        echo "${{algo}}"
                        printf '%s\\n' "${{vals[@]}}"
                        break
                    fi
                done
            '''
            result = subprocess.run(
                ["bash", "-c", cmd],
                capture_output=True,
                text=True,
                cwd=pkgbuild_path.parent,
            )

            if result.returncode != 0:
                return None

            meta, _, rest = result.stdout.partition("\n---SOURCE---\n")
            sources_raw, _, rest = rest.partition("\n---INSTALL---\n")
            install_raw, _, sums_raw = rest.partition("\n---SUMS---\n")

            # First line of the sums section names the algorithm, the rest are
            # the digests in source=() order.
            sums_lines = [s for s in sums_raw.split("\n") if s]
            sum_algo = sums_lines[0] if sums_lines else ""
            sums = sums_lines[1:]

            parts = meta.strip().split("|")
            if len(parts) < 4:
                return None

            # Get list of tracked files in the package directory (excluding PKGBUILD)
            pkg_dir = pkgbuild_path.parent
            result = self.run_git(
                ["ls-files"], capture_output=True, text=True, cwd=pkg_dir, check=True
            )
            files = []
            for file in result.stdout.strip().split("\n"):
                if file and file != "PKGBUILD":
                    files.append(file)
            files.sort()

            return {
                "name": parts[0],
                "version": f"{parts[1]}-{parts[2]}",
                "description": parts[3],
                "url": parts[4] if len(parts) > 4 else "",
                "files": files,
                "sources": [s for s in sources_raw.split("\n") if s],
                "install": install_raw.strip(),
                "sum_algo": sum_algo,
                "sums": sums,
            }
        except Exception as e:
            error(f"Failed to parse {pkgbuild_path}: {e}")
            return None

    def cmd_new(self, package_name: str):
        """Create a new package from template"""
        pkg_dir = self.pkgbuilds_dir / package_name

        if pkg_dir.exists():
            error(f"Package '{package_name}' already exists!")
            return 1

        info(f"Creating new package: {package_name}")
        pkg_dir.mkdir(parents=True)

        # Create template PKGBUILD
        pkgbuild_template = f"""# Maintainer: Your Name <your.email@example.com>

pkgname={package_name}
pkgver=1.0.0
pkgrel=1
pkgdesc="Description of {package_name}"
arch=('x86_64')
url="https://example.com"
license=('GPL')
depends=()
makedepends=()
source=()
sha256sums=()

package() {{
    # Installation commands here
    :
}}
"""

        (pkg_dir / "PKGBUILD").write_text(pkgbuild_template)
        success(f"Created package template at {pkg_dir}")
        info("Edit the PKGBUILD and run 'ap-dev test' to build locally")
        return 0

    def cmd_test(self, package_name: Optional[str] = None):
        """Test build a package locally"""
        if package_name:
            pkg_dirs = [self.pkgbuilds_dir / package_name]
        else:
            # Find package in current directory
            if (Path.cwd() / "PKGBUILD").exists():
                pkg_dirs = [Path.cwd()]
            else:
                error("No PKGBUILD found in current directory")
                return 1

        for pkg_dir in pkg_dirs:
            if not pkg_dir.exists():
                error(f"Package directory not found: {pkg_dir}")
                continue

            info(f"Building package in {pkg_dir}")
            result = subprocess.run(["makepkg", "-sf"], cwd=pkg_dir)

            if result.returncode == 0:
                success("Package built successfully")
                # List built packages
                for pkg_file in pkg_dir.glob("*.pkg.tar.zst"):
                    info(f"Built: {pkg_file.name}")
            else:
                error("Build failed")
                return 1

        return 0

    def cmd_update(self):
        """Update packages.json from all PKGBUILDs"""
        info("Scanning for packages...")
        packages = []

        for pkg_dir in sorted(self.pkgbuilds_dir.iterdir()):
            if not pkg_dir.is_dir():
                continue

            pkgbuild = pkg_dir / "PKGBUILD"
            if not pkgbuild.exists():
                warning(f"No PKGBUILD in {pkg_dir.name}, skipping")
                continue

            pkg_info = self.parse_pkgbuild(pkgbuild)
            if pkg_info:
                # Publish only the fields ap consumes. parse_pkgbuild also
                # returns source=()/install= data, which exists for ap-dev check
                # and has no business in the published manifest.
                packages.append(
                    {
                        key: pkg_info[key]
                        for key in ("name", "version", "description", "url", "files")
                    }
                )
                info(f"Found: {pkg_info['name']} {pkg_info['version']}")

                # Generate .SRCINFO for each package
                result = subprocess.run(
                    ["makepkg", "--printsrcinfo"],
                    cwd=pkg_dir,
                    capture_output=True,
                    text=True,
                )

                if result.returncode == 0:
                    srcinfo_path = pkg_dir / ".SRCINFO"
                    srcinfo_path.write_text(result.stdout)
                else:
                    warning(f"Failed to generate .SRCINFO for {pkg_dir.name}")
            else:
                warning(f"Failed to parse {pkg_dir.name}/PKGBUILD")

        # Get ap version from the ap script
        ap_version = "unknown"
        ap_script = self.repo_root / "ap"
        if ap_script.exists():
            try:
                content = ap_script.read_text()
                match = re.search(r'^VERSION="([^"]+)"', content, re.MULTILINE)
                if match:
                    ap_version = match.group(1)
            except Exception:
                pass

        # Backup existing packages.json
        if self.packages_json.exists():
            shutil.copy(self.packages_json, self.packages_json.with_suffix(".json.bak"))

        # Write new packages.json with tool versions
        data = {"packages": packages, "tools": {"ap": ap_version, "ap-dev": VERSION}}

        with open(self.packages_json, "w") as f:
            json.dump(data, f, indent=2)

        success(f"Updated packages.json with {len(packages)} packages")
        info(f"Tool versions: ap v{ap_version}, ap-dev v{VERSION}")
        return 0

    def cmd_publish(self):
        """Update packages.json, commit, and push"""
        info("Publishing repository...")

        try:
            # Stage first: packages.json builds each package's file list from
            # `git ls-files`, so a newly added source file must be in the index
            # before cmd_update() runs or it is silently left out of the publish
            # that introduces it.
            self.run_git(["add", "-A"], check=True)

            if self.cmd_update() != 0:
                return 1

            # Pick up packages.json itself, which cmd_update() just rewrote.
            self.run_git(["add", "-A"], check=True)

            # Check if there are changes
            result = self.run_git(
                ["diff", "--cached", "--exit-code"], capture_output=True
            )

            if result.returncode == 0:
                info("No changes to publish")
                return 0

            # Commit
            self.run_git(["commit", "-m", "Update packages"], check=True)

            # Push
            self.run_git(["push"], check=True)

            success("Published successfully!")
            info(
                "Changes will be live at https://angelsen.github.io/arch-repo/ in a few minutes"
            )

        except subprocess.CalledProcessError as e:
            error(f"Git operation failed: {e}")
            return 1

        return 0

    def verify_local_checksums(
        self, pkg_dir: Path, pkg_info: Dict, local_sources: List[Tuple[int, str]]
    ) -> int:
        """Check the recorded digest of each in-tree source file.

        Only local sources are hashed. A remote URL is pinned and cannot change
        under us, while a file in the package dir silently desyncs the moment it
        is edited or reformatted after updpkgsums last ran -- which is exactly
        how a package can pass check, pass publish, and still fail to build.
        Hashing local files is cheap; verifying remote ones would mean
        re-downloading them on every check.
        """
        if not local_sources:
            return 0

        sums = pkg_info.get("sums", [])
        algo = self.SUM_ALGOS.get(pkg_info.get("sum_algo", ""))
        if not algo:
            warning(f"{pkg_dir.name}: no recognized *sums array, skipping checksums")
            return 0

        sources = pkg_info.get("sources", [])
        if len(sums) != len(sources):
            error(
                f"{pkg_dir.name}: {len(sources)} sources but {len(sums)} "
                f"{pkg_info['sum_algo']}sums; makepkg will refuse this"
            )
            return 1

        failures = 0
        for index, name in local_sources:
            expected = sums[index]
            if expected.upper() == "SKIP":
                continue
            path = pkg_dir / name
            if not path.exists():
                continue  # already reported as missing by the caller
            actual = self.file_digest(path, algo)
            if actual != expected.lower():
                error(
                    f"{pkg_dir.name}: '{name}' does not match its recorded "
                    f"{pkg_info['sum_algo']}sum; run 'ap-dev updpkgsums {pkg_info['name']}'"
                )
                failures += 1
        return failures

    def cmd_check(self):
        """Validate all PKGBUILDs"""
        info("Checking all packages...")
        errors = 0

        for pkg_dir in sorted(self.pkgbuilds_dir.iterdir()):
            if not pkg_dir.is_dir():
                continue

            pkgbuild = pkg_dir / "PKGBUILD"
            if not pkgbuild.exists():
                warning(f"{pkg_dir.name}: No PKGBUILD found")
                errors += 1
                continue

            # Try to parse it
            pkg_info = self.parse_pkgbuild(pkgbuild)
            if not pkg_info:
                error(f"{pkg_dir.name}: Failed to parse PKGBUILD")
                errors += 1
                continue

            pkg_errors = 0

            # Check for required fields
            if not pkg_info.get("name"):
                error(f"{pkg_dir.name}: Missing pkgname")
                pkg_errors += 1
            if not pkg_info.get("version"):
                error(f"{pkg_dir.name}: Missing version")
                pkg_errors += 1
            if not pkg_info.get("description"):
                warning(f"{pkg_dir.name}: Missing description")

            # Every local source file and the install scriptlet has to be
            # tracked by git, because packages.json builds each package's
            # download list from `git ls-files`. An untracked file builds fine
            # here and then breaks `ap install` for everyone else.
            tracked = set(pkg_info.get("files", []))
            local_sources = self.local_source_files(pkg_info.get("sources", []))
            required = [name for _, name in local_sources]
            if pkg_info.get("install"):
                required.append(pkg_info["install"])

            for name in sorted(set(required)):
                if name in tracked:
                    continue
                if (pkg_dir / name).exists():
                    error(
                        f"{pkg_dir.name}: '{name}' is used by the PKGBUILD but "
                        f"untracked; run 'git add' or ap install cannot fetch it"
                    )
                else:
                    error(
                        f"{pkg_dir.name}: '{name}' is used by the PKGBUILD but missing"
                    )
                pkg_errors += 1

            pkg_errors += self.verify_local_checksums(pkg_dir, pkg_info, local_sources)

            errors += pkg_errors
            if pkg_errors == 0:
                success(f"{pkg_dir.name}: OK")

        if errors > 0:
            error(f"Found {errors} errors")
            return 1
        else:
            success("All packages OK")
            return 0

    def cmd_clean(self):
        """Remove all build artifacts"""
        info("Cleaning build artifacts...")
        patterns = ["*.pkg.tar.zst", "*.pkg.tar.xz", "*.log", "pkg", "src", "*.bak"]

        cleaned = 0
        for pkg_dir in self.pkgbuilds_dir.iterdir():
            if not pkg_dir.is_dir():
                continue

            for pattern in patterns:
                for item in pkg_dir.glob(pattern):
                    if item.is_dir():
                        shutil.rmtree(item)
                        info(f"Removed directory: {item}")
                    else:
                        item.unlink()
                        info(f"Removed file: {item}")
                    cleaned += 1

        success(f"Cleaned {cleaned} items")
        return 0

    def cmd_list(self):
        """List all packages"""
        for pkg_dir in sorted(self.pkgbuilds_dir.iterdir()):
            if not pkg_dir.is_dir():
                continue
            pkgbuild = pkg_dir / "PKGBUILD"
            if pkgbuild.exists():
                pkg_info = self.parse_pkgbuild(pkgbuild)
                if pkg_info:
                    print(
                        f"{pkg_info['name']:<40} {pkg_info['version']:<15} {pkg_info['description'][:50]}"
                    )
                else:
                    print(f"{pkg_dir.name:<40} {'PARSE ERROR':<15}")
        return 0

    def cmd_updpkgsums(self, package_name: str):
        """Update checksums in PKGBUILD"""
        pkg_dir = self.pkgbuilds_dir / package_name

        if not pkg_dir.exists():
            error(f"Package '{package_name}' not found!")
            return 1

        pkgbuild = pkg_dir / "PKGBUILD"
        if not pkgbuild.exists():
            error(f"No PKGBUILD found in {package_name}")
            return 1

        info(f"Updating checksums for {package_name}...")

        # Run updpkgsums
        result = subprocess.run(
            ["updpkgsums"], cwd=pkg_dir, capture_output=True, text=True
        )

        if result.returncode == 0:
            success(f"Updated checksums for {package_name}")

            # Generate .SRCINFO too
            info("Generating .SRCINFO...")
            result = subprocess.run(
                ["makepkg", "--printsrcinfo"],
                cwd=pkg_dir,
                capture_output=True,
                text=True,
            )

            if result.returncode == 0:
                srcinfo_path = pkg_dir / ".SRCINFO"
                srcinfo_path.write_text(result.stdout)
                success("Generated .SRCINFO")
            else:
                warning("Failed to generate .SRCINFO")
        else:
            error(f"Failed to update checksums: {result.stderr}")
            return 1

        return 0


def main():
    parser = argparse.ArgumentParser(
        description="ap-dev - Arch package repository development tool"
    )
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # new command
    new_parser = subparsers.add_parser("new", help="Create new package from template")
    new_parser.add_argument("package", help="Package name")

    # test command
    test_parser = subparsers.add_parser("test", help="Build package locally")
    test_parser.add_argument(
        "package",
        nargs="?",
        help="Package name (optional, uses current dir if not specified)",
    )

    # update command
    subparsers.add_parser("update", help="Update packages.json from PKGBUILDs")

    # publish command
    subparsers.add_parser("publish", help="Update, commit and push changes")

    # check command
    subparsers.add_parser("check", help="Validate all PKGBUILDs")

    # clean command
    subparsers.add_parser("clean", help="Remove all build artifacts")

    # list command
    subparsers.add_parser("list", help="List all packages")

    # updpkgsums command
    updpkgsums_parser = subparsers.add_parser(
        "updpkgsums", help="Update checksums in PKGBUILD"
    )
    updpkgsums_parser.add_argument("package", help="Package name")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    ap_dev = ApDev()

    if args.command == "new":
        return ap_dev.cmd_new(args.package)
    elif args.command == "test":
        return ap_dev.cmd_test(args.package)
    elif args.command == "update":
        return ap_dev.cmd_update()
    elif args.command == "publish":
        return ap_dev.cmd_publish()
    elif args.command == "check":
        return ap_dev.cmd_check()
    elif args.command == "clean":
        return ap_dev.cmd_clean()
    elif args.command == "list":
        return ap_dev.cmd_list()
    elif args.command == "updpkgsums":
        return ap_dev.cmd_updpkgsums(args.package)
    else:
        parser.print_help()
        return 1


if __name__ == "__main__":
    sys.exit(main())
